<Window x:Class="SevenzyX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="7zy X"
    Width="1260"
    Height="820"
    MinWidth="1080"
    MinHeight="700"
    WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource BgBrush}">
    <Grid x:Name="LoginView">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*"/>
        <ColumnDefinition Width="0.95*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="44" Style="{StaticResource CardStyle}">
        <Grid>
          <Ellipse Width="330" Height="330" Fill="#FFF9EC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="♛" FontSize="92" Foreground="{StaticResource GoldStrongBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="7zy X" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Performance • controle • simplicidade" Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Width="410" Padding="34" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Bem-vindo" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Entre com seu acesso de comprador ou administrador." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,24"/>
          <TextBlock Text="Usuário" FontWeight="SemiBold"/>
          <TextBox x:Name="UsernameBox" Height="42" Margin="0,6,0,14"/>
          <TextBlock Text="Senha" FontWeight="SemiBold"/>
          <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,6,0,12"/>
          <TextBlock x:Name="LoginStatus" Foreground="#B94040" Margin="0,4,0,8"/>
          <Button x:Name="LoginButton" Content="Entrar" Height="46" Style="{StaticResource GoldButton}" Click="LoginButton_Click"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="AppView" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="♛ 7zy X" FontSize="25" FontWeight="Bold" Foreground="{StaticResource GoldStrongBrush}"/>
            <TextBlock x:Name="UserLabel" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
          </StackPanel>

          <StackPanel Grid.Row="1">
            <Button Content="⌂  Home" Margin="0,3" Style="{StaticResource OutlineButton}" Click="Home_Click"/>
            <Button Content="⚡  Optimization" Margin="0,3" Style="{StaticResource OutlineButton}" Click="Optimization_Click"/>
            <Button Content="↓  Quick Install" Margin="0,3" Style="{StaticResource OutlineButton}" Click="QuickInstall_Click"/>
            <Button Content="🛠  Tools" Margin="0,3" Style="{StaticResource OutlineButton}" Click="Tools_Click"/>
            <Button Content="🌐  Internet Booster" Margin="0,3" Style="{StaticResource OutlineButton}" Click="Internet_Click"/>
            <Button Content="✦  Extra" Margin="0,3" Style="{StaticResource OutlineButton}" Click="Extra_Click"/>
            <Button x:Name="AdminButton" Content="♛  Admin" Margin="0,3" Style="{StaticResource OutlineButton}" Click="Admin_Click"/>
          </StackPanel>

          <StackPanel Grid.Row="2">
            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="7zy X Score" FontWeight="SemiBold"/>
                <TextBlock x:Name="SidebarPercent" Text="--%" FontSize="28" FontWeight="Bold" Foreground="{StaticResource GoldStrongBrush}"/>
                <TextBlock x:Name="SidebarScanLabel" Text="Aguardando scan" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
            </Border>
            <Button Content="Sair" Style="{StaticResource OutlineButton}" Click="Logout_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid x:Name="HomePanel" Margin="30">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="Home" FontSize="30" FontWeight="Bold"/>
              <TextBlock Text="Visão geral do Windows e da otimização." Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <Button Content="Escanear PC" Width="150" Height="42" HorizontalAlignment="Right" Style="{StaticResource GoldButton}" Click="Scan_Click"/>
          </DockPanel>

          <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Text="7zy X Optimization Score" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="HomePercent" Text="--%" FontSize="40" FontWeight="Bold" Foreground="{StaticResource GoldStrongBrush}"/>
                <TextBlock Text="Pontuação ponderada do estado atual do PC." TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0">
              <StackPanel>
                <TextBlock Text="Tweaks disponíveis" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TweakCountText" Text="0" FontSize="36" FontWeight="Bold"/>
                <TextBlock Text="Basic, Security, Customization, Power, Debloat, Privacy, Services e Tweaks." TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="7,0,0,0">
              <StackPanel>
                <TextBlock Text="Estado" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="HomeStateText" Text="READY" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Defender, Firewall e UAC não são desligados pelos presets." TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="0.95*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="6">
                <TextBlock Text="Resultado do último scan" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="ScanSummaryText" Text="Clique em Escanear PC para analisar energia, serviços, inicialização, armazenamento e configurações do Windows." TextWrapping="Wrap" Margin="0,8,0,14" Foreground="{StaticResource MutedBrush}"/>
                <Button Content="Abrir Optimization" Width="190" HorizontalAlignment="Left" Style="{StaticResource GoldButton}" Click="Optimization_Click"/>
              </StackPanel>
              <ListBox x:Name="ScanChecksList" Grid.Column="1" BorderThickness="0" Background="Transparent" MaxHeight="330">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="OptimizationPanel" Margin="28" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel>
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="Optimization" FontSize="30" FontWeight="Bold"/>
              <TextBlock Text="Configurações automáticas, detectáveis e reversíveis." Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="Categoria" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="CategoryFilter" Width="190" Height="36" SelectionChanged="CategoryFilter_SelectionChanged"/>
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Quick methods" FontWeight="Bold"/>
                <TextBlock Text="Basic = conservador • Optimal = recomendado • Maximum PRO = inclui agressivos." Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Default" Margin="8,0,0,0" Style="{StaticResource OutlineButton}" Click="Default_Click"/>
                <Button Content="Basic" Margin="8,0,0,0" Style="{StaticResource OutlineButton}" Click="Basic_Click"/>
                <Button Content="Optimal" Margin="8,0,0,0" Style="{StaticResource GoldButton}" Click="Optimal_Click"/>
                <Button Content="Maximum PRO" Margin="8,0,0,0" Style="{StaticResource GoldButton}" Click="Maximum_Click"/>
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TweaksList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,0,9">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock>
                          <Run Text="{Binding Title}" FontWeight="SemiBold"/>
                          <Run Text="  •  "/>
                          <Run Text="{Binding Category}" Foreground="{StaticResource GoldStrongBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,20,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RiskLabel}" Foreground="{StaticResource GoldStrongBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RestartLabel}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" FontSize="10"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <DockPanel>
              <TextBlock x:Name="ActionStatus" Text="Pronto." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Criar ponto de restauração" Margin="0,0,8,0" Style="{StaticResource OutlineButton}" Click="RestorePoint_Click"/>
                <Button x:Name="RevertButton" Content="Reverter selecionados" Margin="0,0,8,0" Style="{StaticResource OutlineButton}" Click="Revert_Click"/>
                <Button x:Name="ApplyButton" Content="Apply" Width="140" Style="{StaticResource GoldButton}" Click="Apply_Click"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>

        <Grid x:Name="QuickInstallPanel" Margin="30" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Quick Install" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Instalação silenciosa pelo Windows Package Manager (winget)." Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,20,0,0">
            <Button Content="Google Chrome" Tag="Google.Chrome" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource GoldButton}" Click="InstallPackage_Click"/>
            <Button Content="Mozilla Firefox" Tag="Mozilla.Firefox" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource OutlineButton}" Click="InstallPackage_Click"/>
            <Button Content="Discord" Tag="Discord.Discord" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource OutlineButton}" Click="InstallPackage_Click"/>
            <Button Content="Steam" Tag="Valve.Steam" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource OutlineButton}" Click="InstallPackage_Click"/>
            <Button Content="7-Zip" Tag="7zip.7zip" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource OutlineButton}" Click="InstallPackage_Click"/>
            <Button Content="VLC" Tag="VideoLAN.VLC" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource OutlineButton}" Click="InstallPackage_Click"/>
            <Button Content="Spotify" Tag="Spotify.Spotify" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource OutlineButton}" Click="InstallPackage_Click"/>
            <Button Content="WinRAR" Tag="RARLab.WinRAR" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource OutlineButton}" Click="InstallPackage_Click"/>
            <Button Content="Epic Games" Tag="EpicGames.EpicGamesLauncher" Width="190" Height="58" Margin="0,0,12,12" Style="{StaticResource OutlineButton}" Click="InstallPackage_Click"/>
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <TextBlock x:Name="InstallStatus" Text="Selecione um aplicativo." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          </Border>
        </Grid>

        <Grid x:Name="ToolsPanel" Margin="30" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Tools" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Limpeza, restauração, Explorer e inicialização automática." Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,18,0,14">
            <Button Content="Limpar temporários" Margin="0,0,10,10" Style="{StaticResource GoldButton}" Click="CleanTemp_Click"/>
            <Button Content="Esvaziar lixeira" Margin="0,0,10,10" Style="{StaticResource OutlineButton}" Click="Recycle_Click"/>
            <Button Content="Ponto de restauração" Margin="0,0,10,10" Style="{StaticResource OutlineButton}" Click="RestorePoint_Click"/>
            <Button Content="Reiniciar Explorer" Margin="0,0,10,10" Style="{StaticResource OutlineButton}" Click="RestartExplorer_Click"/>
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Autoruns" FontSize="18" FontWeight="Bold"/>
                <Button Content="Atualizar" Width="95" HorizontalAlignment="Right" Style="{StaticResource OutlineButton}" Click="RefreshAutoruns_Click"/>
              </DockPanel>
              <DataGrid x:Name="AutorunsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="180"/>
                  <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="*"/>
                  <DataGridTextColumn Header="Origem" Binding="{Binding Location}" Width="260"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <DockPanel>
              <TextBlock x:Name="ToolStatus" Text="Pronto." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Desativar autorun" Margin="0,0,8,0" Style="{StaticResource OutlineButton}" Click="DisableAutorun_Click"/>
                <Button Content="Restaurar autorun" Style="{StaticResource GoldButton}" Click="RestoreAutorun_Click"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>

        <Grid x:Name="InternetPanel" Margin="30" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Internet Booster" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Ajustes conservadores de TCP e manutenção de rede." Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,20,0,16">
            <Button Content="Perfil recomendado" Margin="0,0,10,10" Style="{StaticResource GoldButton}" Click="NetworkRecommended_Click"/>
            <Button Content="Flush DNS" Margin="0,0,10,10" Style="{StaticResource OutlineButton}" Click="FlushDns_Click"/>
            <Button Content="Reset Winsock" Margin="0,0,10,10" Style="{StaticResource OutlineButton}" Click="ResetWinsock_Click"/>
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="Observação" FontWeight="Bold" FontSize="18"/>
              <TextBlock Text="O 7zy X não altera DNS para servidores de terceiros automaticamente e não aplica valores TCP experimentais. O perfil recomendado mantém autotuning normal, RSS ligado, ECN desligado e limpa o cache DNS." TextWrapping="Wrap" Margin="0,8,0,18"/>
              <TextBlock x:Name="NetworkStatus" Text="Pronto." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="ExtraPanel" Margin="30" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Extra" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Diagnóstico e informações do sistema." Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Text="System summary" FontSize="18" FontWeight="Bold"/>
              <TextBlock x:Name="SystemSummaryText" Text="Carregando..." Margin="0,10,0,20" TextWrapping="Wrap"/>
              <Button Content="Executar novo scan completo" Width="220" HorizontalAlignment="Left" Style="{StaticResource GoldButton}" Click="ExtraScan_Click"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="AdminPanel" Margin="30" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Admin" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Gerencie compradores, bloqueio e validade local deste painel." Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Usuário" FontWeight="SemiBold"/><TextBox x:Name="AdminUsernameBox" Height="38" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Senha" FontWeight="SemiBold"/><PasswordBox x:Name="AdminPasswordBox" Height="38" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Validade (dias)" FontWeight="SemiBold"/><TextBox x:Name="AdminValidityBox" Text="30" Height="38" Margin="0,6,0,0"/></StackPanel>
              <Button Grid.Column="3" Content="Criar comprador" VerticalAlignment="Bottom" Height="38" Style="{StaticResource GoldButton}" Click="CreateBuyer_Click"/>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="AdminUsersGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" Background="White">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Usuário" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Perfil" Binding="{Binding Role}" Width="130"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                <DataGridTextColumn Header="Expiração" Binding="{Binding Expiration}" Width="210"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <DockPanel>
              <TextBlock x:Name="AdminStatus" Text="Selecione uma conta para gerenciar." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Renovar validade" Margin="8,0,0,0" Style="{StaticResource OutlineButton}" Click="ExtendBuyer_Click"/>
                <Button Content="Bloquear / Desbloquear" Margin="8,0,0,0" Style="{StaticResource OutlineButton}" Click="ToggleBuyer_Click"/>
                <Button Content="Remover" Margin="8,0,0,0" Style="{StaticResource GoldButton}" Click="DeleteBuyer_Click"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="ScanOverlay"
            Grid.ColumnSpan="2"
            Panel.ZIndex="100"
            Background="#B3000000"
            Visibility="Collapsed">
        <Border Width="520"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="♛" FontSize="42" HorizontalAlignment="Center" Foreground="{StaticResource GoldStrongBrush}"/>
            <TextBlock x:Name="ScanOverlayTitle"
                       Text="Escaneando PC"
                       FontSize="25"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,6"/>
            <TextBlock x:Name="ScanOverlayStep"
                       Text="Preparando análise…"
                       Foreground="{StaticResource MutedBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MinHeight="42"
                       Margin="0,0,0,18"/>
            <ProgressBar x:Name="ScanProgressBar"
                         Height="9"
                         IsIndeterminate="True"
                         Margin="0,0,0,16"/>
            <TextBlock Text="O resultado será atualizado automaticamente quando o scan terminar."
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>