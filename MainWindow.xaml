<Window x:Class="SevenzyX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="7zy X"
    Width="1180"
    Height="760"
    MinWidth="1000"
    MinHeight="650"
    WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource BgBrush}">
    <Grid x:Name="LoginView">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.08*"/>
        <ColumnDefinition Width="0.92*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="42" Style="{StaticResource CardStyle}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="♛" FontSize="86" Foreground="{StaticResource GoldStrongBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="7zy X" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Text="Performance, controle e simplicidade."
                     Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Width="390" Padding="32"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Entrar" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Use seu acesso de comprador ou administrador."
                     Foreground="{StaticResource MutedBrush}" Margin="0,6,0,24"/>
          <TextBlock Text="Usuário" FontWeight="SemiBold"/>
          <TextBox x:Name="UsernameBox" Height="42" Margin="0,6,0,14"/>
          <TextBlock Text="Senha" FontWeight="SemiBold"/>
          <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,6,0,12"/>
          <TextBlock x:Name="LoginStatus" Foreground="#B94040" Margin="0,4,0,8"/>
          <Button x:Name="LoginButton" Content="Entrar" Height="46"
                  Style="{StaticResource GoldButton}" Click="LoginButton_Click"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="AppView" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="♛ 7zy X" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GoldStrongBrush}"/>
            <TextBlock x:Name="UserLabel" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20"/>
          </StackPanel>

          <StackPanel Grid.Row="1">
            <Button Content="⌂  Home" Margin="0,4" Style="{StaticResource OutlineButton}" Click="Home_Click"/>
            <Button Content="⚡  Optimization" Margin="0,4" Style="{StaticResource OutlineButton}" Click="Optimization_Click"/>
            <Button x:Name="AdminButton" Content="♛  Admin" Margin="0,4"
                    Style="{StaticResource OutlineButton}" Click="Admin_Click"/>
          </StackPanel>

          <StackPanel Grid.Row="2">
            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Optimization" FontWeight="SemiBold"/>
                <TextBlock x:Name="SidebarPercent" Text="0%" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource GoldStrongBrush}"/>
              </StackPanel>
            </Border>
            <Button Content="Sair" Style="{StaticResource OutlineButton}" Click="Logout_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid x:Name="HomePanel" Margin="34">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Home" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Seu painel de otimização 7zy X." Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="Optimization" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="HomePercent" Text="0%" FontSize="38" FontWeight="Bold"
                           Foreground="{StaticResource GoldStrongBrush}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0">
              <StackPanel>
                <TextBlock Text="Status" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="READY" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Ações automáticas e reversíveis."/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
              <StackPanel>
                <TextBlock Text="Maximum PRO" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Aggressive" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Preset separado para mudanças mais pesadas." TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="28">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="7zy X" FontSize="42" FontWeight="Bold"/>
                <TextBlock Text="Otimize o Windows sem abrir Registro, CMD ou Serviços manualmente."
                           FontSize="17" TextWrapping="Wrap" Margin="0,8,0,22"/>
                <Button Content="Start optimization" Width="220" HorizontalAlignment="Left"
                        Style="{StaticResource GoldButton}" Click="Optimization_Click"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="♛" FontSize="150" Foreground="{StaticResource GoldBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="OptimizationPanel" Margin="30" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Optimization" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Basic settings" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>

          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,16">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Quick methods" FontWeight="Bold"/>
                <TextBlock Text="Escolha um preset e clique em Apply." Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Default" Margin="8,0,0,0" Style="{StaticResource OutlineButton}" Click="Default_Click"/>
                <Button Content="Basic" Margin="8,0,0,0" Style="{StaticResource OutlineButton}" Click="Basic_Click"/>
                <Button Content="Optimal" Margin="8,0,0,0" Style="{StaticResource GoldButton}" Click="Optimal_Click"/>
                <Button Content="Maximum PRO" Margin="8,0,0,0" Style="{StaticResource GoldButton}" Click="Maximum_Click"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TweaksList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,4,20,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Risk}" Foreground="{StaticResource GoldStrongBrush}"
                                 VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <DockPanel>
              <TextBlock x:Name="ActionStatus" Text="Pronto." VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RevertButton" Content="Reverter selecionados" Margin="0,0,10,0"
                        Style="{StaticResource OutlineButton}" Click="Revert_Click"/>
                <Button x:Name="ApplyButton" Content="Apply" Width="150"
                        Style="{StaticResource GoldButton}" Click="Apply_Click"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>

        <Grid x:Name="AdminPanel" Margin="34" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Admin" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Área administrativa inicial do 7zy X." Foreground="{StaticResource MutedBrush}"/>
            <Border Style="{StaticResource CardStyle}" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock Text="Controle de compradores" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Nesta primeira build o fluxo Admin/Comprador já existe. O cadastro remoto/licenciamento será conectado numa etapa separada para não depender de credenciais locais."
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>